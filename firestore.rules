rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global deny — explicit allows only
    match /{document=**} { allow read, write: if false; }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    // Strict admin: only owner, super_admin and admin roles
    function isAdmin() {
      return isSignedIn() && getUserRole() in ['owner', 'super_admin', 'admin'];
    }

    // Any back-office staff role (all non-customer, non-wholesale)
    function isStaff() {
      return isSignedIn() && getUserRole() in [
        'owner', 'super_admin', 'admin', 'manager', 'accounting',
        'customer_service', 'inventory', 'warehouse', 'barista',
        'marketing', 'supplier_manager', 'support', 'analyst',
        'product_manager', 'wholesale_manager'
      ];
    }

    // Roles trusted to record money events (COD collection, refunds, payment status)
    function isAdminOrAccounting() {
      return isSignedIn() && getUserRole() in ['owner', 'super_admin', 'admin', 'manager', 'accounting'];
    }

    // Driver: can view/update only their assigned deliveries
    function isDriver() {
      return isSignedIn() && getUserRole() == 'driver';
    }

    // Granular permission check: reads a 'permissions' string array on the user profile
    // Usage: hasPermission('orders:write')
    function hasPermission(perm) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && perm in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', []);
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 100
        && data.role in [
          'owner', 'super_admin', 'admin', 'manager', 'accounting',
          'customer_service', 'inventory', 'warehouse', 'barista',
          'marketing', 'supplier_manager', 'support', 'analyst',
          'product_manager', 'wholesale_manager',
          'wholesale', 'customer', 'driver'
        ];
    }

    function isValidContactMessage(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000
        && data.status == 'unread';
    }

    function isValidWholesaleInquiry(data) {
      return data.userId == request.auth.uid
        && data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 200
        && data.location is string && data.location.size() > 0 && data.location.size() <= 200
        && data.status == 'pending';
    }

    function isValidFaq(data) {
      return data.question is string && data.question.size() > 0
        && data.answer is string && data.answer.size() > 0
        && data.order is number;
    }

    // Owner updating own profile: only profile fields, never change role/permissions/status.
    // Includes notification preferences, FCM tokens, email verification status,
    // and personal preferences — all user-editable without elevation.
    // Business/accounting values (loyaltyPoints, totalSpent) are NOT owner-editable:
    // they are computed and maintained by trusted server-side logic (F3).
    function isOwnerProfileUpdate() {
      return incoming().get('role', null) == existing().get('role', null)
        && incoming().get('permissions', []) == existing().get('permissions', [])
        && incoming().get('status', null) == existing().get('status', null)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'firstName', 'lastName', 'phone', 'address', 'addresses', 'defaultAddressId',
          'avatar', 'profileImage', 'preferences', 'notificationPreferences', 'fcmTokens',
          'emailVerified', 'onboarded', 'updatedAt'
        ]);
    }

    // --- Order status authorization matrix (F1) ---
    // Mirrors functions/lib/stateMachine.ts role sets. Least privilege:
    //  - ORDER_OPS_TOP (owner/super_admin/admin/manager): every valid transition
    //  - support (customer_service, support): non-financial transitions, never 'delivered'
    //  - fulfillment (inventory, warehouse, barista, supplier_manager): staging only,
    //    never 'cancelled'/'delivered'
    //  - accounting: payment/financial operations ONLY (no status authority)
    //  - product_manager / marketing / analyst / wholesale_manager: no order-status
    //    authority; customer / driver: separate non-staff paths
    function isOrderOpsTop() {
      return isSignedIn() && getUserRole() in ['super_admin', 'owner', 'admin', 'manager'];
    }
    function isOrderSupport() {
      return isSignedIn() && getUserRole() in ['super_admin', 'owner', 'admin', 'manager', 'customer_service', 'support'];
    }
    function isFulfillmentWorker() {
      return isSignedIn() && getUserRole() in ['super_admin', 'owner', 'admin', 'manager', 'inventory', 'warehouse', 'barista', 'supplier_manager'];
    }
    function isOrderTransitionAuthorized(from, to) {
      return isOrderOpsTop()
        || (isOrderSupport() && to != 'delivered')
        || (isFulfillmentWorker() && to in ['processing', 'preparing', 'ready', 'shipped', 'out_for_delivery']);
    }

    // Non-staff blog engagement: only counters
    function isBlogEngagementUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'likesCount', 'sharesCount', 'commentsCount'
      ]);
    }

    // --- Order state machine ---
    // Mirrors functions/lib/stateMachine.ts ORDER_TRANSITIONS.
    function isValidOrderTransition(from, to) {
      return (from == 'pending' && to in ['confirmed', 'cancelled'])
        || (from == 'confirmed' && to in ['processing', 'cancelled'])
        || (from == 'processing' && to in ['preparing', 'cancelled'])
        || (from == 'preparing' && to in ['ready', 'cancelled'])
        || (from == 'ready' && to in ['shipped', 'out_for_delivery', 'cancelled'])
        || (from == 'shipped' && to == 'out_for_delivery')
        || (from == 'out_for_delivery' && to in ['delivered', 'cancelled']);
    }

    // Payment lifecycle for COD: pending -> collected | failed | refunded; never 'paid' fiction.
    function isValidPaymentTransition(from, to) {
      return (from == 'pending' && to in ['collected', 'failed', 'refunded'])
        || (from == 'collected' && to == 'refunded')
        || (from == 'failed' && to in ['collected', 'refunded']);
    }

    function isValidOrderStatus(s) {
      return s in ['pending', 'confirmed', 'processing', 'preparing', 'ready', 'shipped', 'out_for_delivery', 'delivered', 'cancelled'];
    }

    // Staff order update: bounded keys, valid + role-authorized transitions,
    // money events only by admin/accounting, driver assignment only by admin.
    function isStaffOrderUpdate() {
      return isSignedIn() && getUserRole() != null && (isOrderOpsTop() || isOrderSupport() || isFulfillmentWorker())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'trackingId', 'driverId', 'driverName', 'updatedAt', 'deliveredAt',
          'paymentStatus', 'codAmountCollected', 'paymentCollectedAt',
          'cancellationReason', 'cancelledAt', 'internalNotes'
        ])
        && (!('status' in incoming()) || (
             isValidOrderStatus(incoming().status)
             && isValidOrderTransition(existing().status, incoming().status)
             && isOrderTransitionAuthorized(existing().status, incoming().status)))
        && (!('paymentStatus' in incoming()) || (
             isAdminOrAccounting() && isValidPaymentTransition(existing().get('paymentStatus', 'pending'), incoming().paymentStatus)))
        && (!('codAmountCollected' in incoming()) || isAdminOrAccounting())
        && (!('driverId' in incoming()) || isAdmin());
    }

    // Driver delivery update: ONLY once the order is out_for_delivery (F2),
    // only mark delivered, optionally record COD collection on an honest amount.
    function isDriverOrderUpdate() {
      return isDriver()
        && existing().get('driverId', '') == request.auth.uid
        && existing().get('status', '') == 'out_for_delivery'
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'paymentStatus', 'deliveredAt', 'codAmountCollected', 'updatedAt'
        ])
        && incoming().status == 'delivered'
        && (!('paymentStatus' in incoming()) || (
             incoming().paymentStatus in ['collected', 'failed']
             && existing().get('paymentStatus', 'pending') == 'pending'))
        && (!('codAmountCollected' in incoming()) || (
             incoming().paymentStatus == 'collected'
             && incoming().codAmountCollected is number
             && incoming().codAmountCollected > 0
             && incoming().codAmountCollected == existing().get('totalLbp', existing().get('total', 0))));
    }

    // Subscription owner pausing/cancelling/resuming and updating logistics.
    // Allows customers to self-serve pause/cancel/resume and edit delivery details.
    function isOwnerSubscriptionUpdate() {
      return request.auth.uid == resource.data.userId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'updatedAt', 'pausedAt', 'pausedUntil', 'frequency', 'address',
          'preferredTimeSlot', 'preferredTime', 'customNotes', 'gateCode', 'nextDelivery', 'durationMonths', 'items'
        ])
        && (!('status' in incoming()) || incoming().status in ['active', 'paused', 'cancelled']);
    }

    function isValidSubscriptionTransition(from, to) {
      return (from == 'active' && to in ['paused', 'cancelled'])
        || (from == 'paused' && to in ['active', 'cancelled']);
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isSignedIn() && (userId == request.auth.uid || isStaff());
      allow list: if isStaff();
      allow create: if isSignedIn() && request.auth.uid == userId
        && (!('role' in incoming()) || incoming().role == 'customer')
        && !('permissions' in incoming()) && !('status' in incoming())
        && (!('loyaltyPoints' in incoming()) || incoming().loyaltyPoints == 0)
        && (!('totalSpent' in incoming()) || incoming().totalSpent == 0);
      allow update: if isAdmin() || (request.auth.uid == userId && isOwnerProfileUpdate());
      allow delete: if isAdmin();
    }

    // --- Products (public read) ---
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // --- Subscription plans (public read) ---
    match /plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // --- Categories (public read; staff CRUD) ---
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // --- CMS (public read visible only) ---
    match /cms_content/{docId} {
      allow get: if resource.data.visible == true || isStaff();
      allow list: if isStaff() || (resource.data.visible == true);
      allow create, update, delete: if isStaff();
    }

    // --- Blog (public read published; engagement updates allowed) ---
    match /blog_posts/{postId} {
      allow get: if resource.data.status == 'published' || isStaff();
      allow list: if isStaff() || resource.data.status == 'published';
      allow create, delete: if isStaff();
      allow update: if isStaff() || (resource.data.status == 'published' && isBlogEngagementUpdate());
    }

    // --- FAQs (public read visible only) ---
    match /faqs/{faqId} {
      allow get: if resource.data.visible == true || isStaff();
      allow list: if isStaff() || (resource.data.visible == true);
      allow create: if isStaff() && isValidFaq(incoming());
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // --- Contact messages ---
    match /contact_messages/{messageId} {
      allow create: if isValidContactMessage(incoming());
      allow get, list, update, delete: if isStaff();
      match /replies/{replyId} {
        allow create, read: if isStaff();
      }
    }

    // --- Reviews ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerified()
        && incoming().userId == request.auth.uid
        && incoming().productId is string
        && incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5;
      allow update, delete: if isStaff();
    }

    // --- Wishlist ---
    match /wishlist/{userId} {
      allow get, write: if isOwner(userId);
    }

    // --- Orders ---
    // NOTE: orders are created ONLY by the server (Pages Function /api/orders
    // using the service account, which bypasses rules). Clients cannot create
    // orders directly, so client-side totals can never be trusted.
    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        isOwner(existing().userId)
        || isStaff()
        || (isDriver() && existing().get('driverId', '') == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isStaff()
        || (isDriver() && resource.data.get('driverId', '') == request.auth.uid)
      );
      allow create: if false;
      allow update: if isStaffOrderUpdate() || isDriverOrderUpdate();
      allow delete: if false;
    }

    // --- Idempotency guards (server-only) ---
    match /order_requests/{requestId} {
      allow read, write: if false;
    }
    match /sub_requests/{requestId} {
      allow read, write: if false;
    }

    // --- Subscriptions ---
    // Created ONLY by the server (Pages Function /api/subscriptions).
    match /subscriptions/{subId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isStaff());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if false;
      allow update: if isStaff() && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'paymentStatus', 'nextDelivery', 'endDate', 'cancelledAt',
          'cancellationReason', 'pausedUntil', 'updatedAt', 'internalNotes'
        ])
        && (!('status' in incoming()) || isValidSubscriptionTransition(existing().status, incoming().status))
        && (!('paymentStatus' in incoming()) || (
             isAdminOrAccounting() && isValidPaymentTransition(existing().get('paymentStatus', 'pending'), incoming().paymentStatus)))
      ) || isOwnerSubscriptionUpdate();
      allow delete: if isStaff();
    }

    // --- Deliveries ---
    match /deliveries/{deliveryId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isStaff());
      allow list: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isStaff();
    }

    // --- Payments ---
    // Money events are recorded server-side only; clients can never mint
    // payment records.
    match /payments/{paymentId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isStaff());
      allow list: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update, delete: if isStaff();
    }

    // --- Payment ledgers ---
    match /paymentLedgers/{ledgerId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isStaff());
      allow list: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update, delete: if isStaff();
    }

    // --- Site Settings ---
    match /site_settings/{docId} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if isStaff();
    }

    // --- Carts (user-owned) ---
    match /carts/{userId} {
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Audit Logs ---
    match /audit_logs/{logId} {
      allow create: if isStaff();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // --- Wholesale inquiries ---
    match /wholesale_accounts/{accountId} {
      allow get: if isStaff() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isStaff();
      allow create: if isVerified() && isValidWholesaleInquiry(incoming());
      allow update, delete: if isStaff();
    }

    // --- Offers (AI-generated, admin approved) ---
    match /offers/{offerId} {
      allow read: if isStaff() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- Coupons ---
    // Customers may read active coupons; ALL writes (including usedCount) are
    // staff/server-only. Coupon usage is now counted atomically when an order
    // is created server-side, not when the customer applies it in the cart.
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create, delete: if isStaff();
      allow update: if isStaff();
    }

    // --- Employee Invites ---
    match /employee_invites/{email} {
      allow read, write: if isStaff();
    }

    // --- Employees ---
    match /employees/{employeeId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }
  }
}
